{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "0.0.0.0:9090",
      "external_ui": "zashboard",
      "secret": "singbox",
      "external_ui_download_detour": "Proxy",
      "external_ui_download_url": "https://github.com/musiyun124/zashboard/archive/refs/heads/gh-pages-no-fonts.zip"
    },
    "debug": {
      "memory_limit": 134217728
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "::",
      "listen_port": 9999,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "s-download",
        "update_interval": "3h"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/18",
        "inet6_range": "fc00::/18"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ]
        }
      },
      {
        "tag": "dns-proxy",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "dns-direct",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "domain": "myip.ipip.net",
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": [
          "AD",
          "Webrtc_domain"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": [
          "cn",
          "googlefcm"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "Fake-IP-Filter"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "prefer_ipv4",
    "cache_capacity": 2048
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "Speedtest",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "TG DC5",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "TG DC4",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "AI",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "NodeSeek",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "YouTube",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "HK",
        "TW",
        "SG",
        "EU",
        "MO"
      ],
      "default": "Proxy"
    },
    {
      "tag": "HK",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.google.com/generate_204",
      "interval": "5m",
      "tolerance": 2
    },
    {
      "tag": "TW",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.google.com/generate_204",
      "interval": "5m",
      "tolerance": 2
    },
    {
      "tag": "SG",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.google.com/generate_204",
      "interval": "5m",
      "tolerance": 2
    },
    {
      "tag": "EU",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.google.com/generate_204",
      "interval": "5m",
      "tolerance": 2
    },
    {
      "tag": "MO",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.google.com/generate_204",
      "interval": "5m",
      "tolerance": 2
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "default_http_client": "s-download",
    "rule_set": [
      {
        "type": "remote",
        "tag": "AD",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": [
          "Webrtc_domain",
          "TelegramSG",
          "TelegramNL",
          "SpeedtestInternational",
          "SpeedtestInternational_ipcidr"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Ethan2258/Ethan2258/main/{tag}.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": "AI",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/xndeye/rule-merger/release/ai.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": [
          "googlefcm",
          "youtube",
          "nodeseek",
          "cn"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/{tag}.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": "Google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/google.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": "Google_IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/google.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": "CN_IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "update_interval": "3h",
        "http_client": "s-download"
      },
      {
        "type": "remote",
        "tag": "Fake-IP-Filter",
        "format": "binary",
        "url": "https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/fakeip-filter.srs",
        "update_interval": "1d",
        "http_client": "s-download"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "rule_set": [
          "cn",
          "googlefcm"
        ],
        "action": "resolve",
        "server": "dns-direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "AD",
          "Webrtc_domain"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "AI"
        ],
        "action": "route",
        "outbound": "AI"
      },
      {
        "port_range": "5228:5230",
        "action": "route",
        "outbound": "direct"
      },
      {
        "port": 7680,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "googlefcm"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "nodeseek"
        ],
        "action": "route",
        "outbound": "NodeSeek"
      },
      {
        "rule_set": [
          "SpeedtestInternational",
          "SpeedtestInternational_ipcidr"
        ],
        "action": "route",
        "outbound": "Speedtest"
      },
      {
        "rule_set": [
          "youtube"
        ],
        "action": "route",
        "outbound": "YouTube"
      },
      {
        "rule_set": [
          "Google",
          "Google_IP"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": [
          "TelegramSG"
        ],
        "action": "route",
        "outbound": "TG DC5"
      },
      {
        "rule_set": [
          "TelegramNL"
        ],
        "action": "route",
        "outbound": "TG DC4"
      },
      {
        "rule_set": [
          "cn",
          "CN_IP"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "auto_detect_interface": true,
    "final": "Proxy"
  }
}
